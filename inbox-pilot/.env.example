# Copy to .env for `npm run dev`. On Vercel, set these in Project Settings → Environment Variables.

# Login password for the app (single user).
APP_PASSWORD=
# Long random string (32+ chars). Signs your login cookie and encrypts Google tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Google Cloud OAuth client (Web application). See README step 2.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API key.
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5). Set claude-haiku-4-5 to cut AI cost further.
# AI_MODEL=

# Vercel KV / Upstash Redis (added automatically when you connect a KV store on Vercel).
# Leave empty locally to use an in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Inngest (background jobs + daily brief schedule). Leave empty locally: triage runs inline.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional tuning
# APP_URL=https://your-app.vercel.app   # only if the OAuth redirect URL comes out wrong
# INITIAL_LOOKBACK_DAYS=7               # how far back the first run looks
# MAX_EMAILS_PER_RUN=600
