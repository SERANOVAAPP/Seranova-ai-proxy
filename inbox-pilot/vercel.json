{
  "functions": {
    "api/router.js": { "maxDuration": 300 },
    "api/inngest.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/inngest", "destination": "/api/inngest" },
    { "source": "/api/:path*", "destination": "/api/router?route=:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
